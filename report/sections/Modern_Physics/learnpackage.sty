%%------------------tikz设定----------------
\RequirePackage{tikz}
\usetikzlibrary{
	arrows.meta,
	chains,
	matrix,
	positioning,
	mindmap,
	shadows,
	backgrounds
	}
\tikzset{
	>=latex,%% 箭头样式
	box/.style={
		rectangle,%% 矩形节点
		rounded corners =5pt,%% 圆角
		minimum width=50pt,%% 最小宽度
		minimum height=20pt,%% 最小高度
		inner sep=5pt,%% 文字和边框的距离
		draw= %% 边框颜色
	},
	box 2/.style={
		rectangle,%% 矩形节点
		rounded corners =0,%% 圆角
		minimum width=50pt,%% 最小宽度
		minimum height=10pt,%% 最小高度
		inner sep=4pt,%% 文字和边框的距离
		draw=cyan, %% 边框颜色
		font=\scriptsize\kaishu},
	box 3/.style={
		circle,%% 矩形节点
		minimum width=8pt,%% 最小宽度
		minimum height=8pt,%% 最小高度
		inner sep=4pt,%% 文字和边框的距离
		draw=cyan}, %% 边框颜色
	arrow/.style={
		arrows={-Triangle[angle=30:2.5pt 3]},
		line width=1pt,
		color=teal!60},
	every on chain/.style={ 
		join=by arrow
	}}

\newcommand{\tikzmark}[3][]{\tikz[remember picture, baseline]\node [anchor=base,#1](#2) {#3};}

